NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/taskmanager
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=super_secret_access_jwt_key_at_least_32_characters_long
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_characters_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
TWO_FACTOR_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

CLOUDINARY_CLOUD_NAME=demo_cloud
CLOUDINARY_API_KEY=1234567890
CLOUDINARY_API_SECRET=sample_secret_key

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=org-task-attachments

EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=noreply@yourorg.com

CLIENT_URL=http://localhost:3000
COOKIE_DOMAIN=localhost

# Monitoring account created by `npm run seed:admin` (must change password at first login)
SEED_ADMIN_EMAIL=admin@yourcompany.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Company Admin

# Require 2FA for superadmin/admin/marketing before they can use the app.
# Defaults to true when NODE_ENV=production, false otherwise.
ENFORCE_PRIVILEGED_2FA=

# SMS for customer OTPs. "console" prints codes to the server log (development only;
# refused in production). Set to "msg91" with a DLT-approved OTP template for real SMS.
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# Secret used to hash OTP codes (at least 32 random characters in production)
OTP_HMAC_SECRET=
# Signs message-franking commitments (report evidence). Keep it stable: changing it makes older messages unverifiable.
FRANKING_SECRET=
# Version of the privacy policy customers accept at sign-up
PRIVACY_POLICY_VERSION=2026-09-28

# Web push for the installable app: generate once with  npx web-push generate-vapid-keys  and keep stable
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bonito.in
# "Your designer replied" alerts: console (development) | msg91 | none
ALERT_PROVIDER=console
MSG91_WHATSAPP_NUMBER=
MSG91_WHATSAPP_TEMPLATE=
MSG91_ALERT_SMS_TEMPLATE_ID=
