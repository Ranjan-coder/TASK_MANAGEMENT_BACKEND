NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/taskmanager
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=super_secret_access_jwt_key_at_least_32_characters_long
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_at_least_32_characters_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
TWO_FACTOR_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

CLOUDINARY_CLOUD_NAME=demo_cloud
CLOUDINARY_API_KEY=1234567890
CLOUDINARY_API_SECRET=sample_secret_key

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=org-task-attachments

EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=noreply@yourorg.com

CLIENT_URL=http://localhost:3000
COOKIE_DOMAIN=localhost
